{
  "appId": "com.zonecity.syndicate",
  "appName": "ZONE",
  "webDir": "public",
  "backgroundColor": "#141210",
  "server": {
    "url": "https://zone-torn-style-game-mockup-6cf978c.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "zone-torn-style-game-mockup-6cf978c.vercel.app",
      "zone-final-team-auraa.vercel.app",
      "*.mapbox.com",
      "api.mapbox.com",
      "events.mapbox.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#141210",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
