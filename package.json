{
  "name": "zone-game-platform",
  "version": "3.0.0",
  "private": true,
  "description": "Bilingual, modular, API-first browser game platform for ZONE.",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "vercel-build": "npm run verify && npm run build && node scripts/verify.mjs public",
    "engine:test": "powershell -ExecutionPolicy Bypass -File engine/bin/test.ps1",
    "engine:serve": "powershell -ExecutionPolicy Bypass -File engine/bin/serve.ps1",
    "verify:platform": "powershell -ExecutionPolicy Bypass -File scripts/verify-platform.ps1"
  },
  "engines": {
    "node": "22.x"
  }
}
