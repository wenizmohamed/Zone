{
  "previous": "<!-- GYM -->\n      <sc-if value=\"{{ is.gym }}\" hint-placeholder-val=\"{{ false }}\">\n        <section class=\"zone-panel zone-gym-workspace\" aria-label=\"{{ trainingBoard.title }}\">\n          <div class=\"zone-gym-floor\"><div class=\"zone-gym-floor-scene\"><header><span class=\"zone-overline\">{{ gymStudio.eyebrow }}</span><h2>{{ gymName }}</h2><p>{{ gymStudio.floorNote }}</p></header></div><div class=\"zone-gym-floor-readout\"><div class=\"zone-gym-energy\"><span>{{ t.energyAvail }}</span><bdi>{{ energyText }}</bdi><div class=\"zone-record-track\" role=\"progressbar\" aria-label=\"{{ t.energy }}\" aria-valuemin=\"0\" aria-valuemax=\"{{ gymStudio.energyMax }}\" aria-valuenow=\"{{ gymStudio.energyNow }}\"><span style=\"width:{{ energyPct }}%\"></span></div></div><div class=\"zone-gym-floor-caption\"><span>{{ t.totalStats }} <bdi>{{ totalStats }}</bdi></span><span>{{ trainingBoard.happyLabel }} <bdi>{{ trainingBoard.happy }}</bdi></span></div></div></div>\n          <div class=\"zone-gym-session\" aria-label=\"{{ gymStudio.sessionLabel }}\" aria-busy=\"{{ gymStudio.busy }}\">\n            <span class=\"zone-overline\">{{ gymStudio.sessionLabel }}</span><div class=\"zone-gym-session-identity\"><span class=\"zone-gym-station-icon\" aria-hidden=\"true\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 512 512\"><path d=\"M0 0\" data-zone-path=\"{{ gymSession.d }}\"></path></svg></span><div><h3>{{ gymSession.label }}</h3><p>{{ gymSession.exercise }}</p></div></div>\n            <dl class=\"zone-gym-session-metrics\"><div><dt>{{ trainingBoard.currentLabel }}</dt><dd><bdi>{{ gymSession.value }}</bdi></dd></div><div><dt>{{ trainingBoard.estimateLabel }}</dt><dd><bdi>+{{ gymSession.gain }}</bdi><small>{{ gymStudio.estimateNote }}</small></dd></div><div><dt>{{ gymStudio.costLabel }}</dt><dd><bdi>{{ gymEnergy }}</bdi> {{ t.energy }}</dd></div><div><dt>{{ gymStudio.balanceLabel }}</dt><dd><bdi>{{ gymStudio.energyAfter }}</bdi> {{ t.energy }}</dd></div></dl>\n            <button class=\"zone-action-primary zone-gym-train\" data-gym-train=\"{{ gymSession.id }}\" onClick=\"{{ gymSession.train }}\" disabled=\"{{ trainOff }}\" data-zbusy=\"{{ gymSession.busy }}\">{{ gymSession.btnLabel }} · {{ gymSession.label }}</button><p class=\"zone-gym-session-reason\" id=\"zone-gym-session-reason\" role=\"status\" aria-live=\"polite\">{{ gymStudio.reason }}</p>\n            <div class=\"zone-gym-happiness\"><p>{{ gymStudio.happyNote }}</p><button onClick=\"{{ gymStudio.openHome }}\">{{ gymStudio.homeLabel }}</button></div>\n            <div class=\"zone-gym-last-session\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"><strong>{{ trainingBoard.resultLabel }}</strong><sc-if value=\"{{ trainingBoard.hasEvents }}\"><sc-for list=\"{{ trainingBoard.events }}\" as=\"event\"><p><bdi>{{ event.time }}</bdi> {{ event.text }}</p></sc-for></sc-if><sc-if value=\"{{ !trainingBoard.hasEvents }}\"><p>{{ gymStudio.emptyResult }}</p></sc-if></div>\n          </div>\n          <div class=\"zone-gym-stations\" role=\"group\" aria-label=\"{{ gymStudio.stationLabel }}\"><sc-for list=\"{{ stats }}\" as=\"s\" hint-placeholder-count=\"4\"><button class=\"zone-gym-station\" data-gym-station=\"{{ s.id }}\" aria-pressed=\"{{ s.selected }}\" onClick=\"{{ s.select }}\"><span class=\"zone-gym-station-art\" style=\"background-image:url('{{ s.img }}')\" aria-hidden=\"true\"></span><span><strong>{{ s.label }}</strong><small>{{ s.exercise }}</small><bdi>{{ s.value }}</bdi></span><span class=\"zone-gym-station-selection\" aria-hidden=\"true\">{{ s.selectionMark }}</span></button></sc-for></div>\n        </section>\n        <section class=\"zone-panel zone-membership-ledger zone-gym-memberships\"><div class=\"zone-panel-heading\">{{ t.gymLadder }} <bdi>{{ gymXp }} {{ t.gymXp }}</bdi></div><div class=\"zone-gym-progression\"><p>{{ trainingBoard.next }}</p><sc-if value=\"{{ gymStudio.hasNext }}\"><div class=\"zone-record-track\" role=\"progressbar\" aria-label=\"{{ gymStudio.progressLabel }}\" aria-valuemin=\"0\" aria-valuemax=\"{{ gymStudio.nextTarget }}\" aria-valuenow=\"{{ gymStudio.nextProgress }}\"><span style=\"width:{{ gymStudio.progressPct }}%\"></span></div><small>{{ gymStudio.progressLabel }}</small></sc-if></div><sc-for list=\"{{ gyms }}\" as=\"g\" hint-placeholder-count=\"8\"><div class=\"zone-membership-row\" data-zone-current=\"{{ g.current }}\"><div><strong>{{ g.name }}</strong><small>{{ g.reason }}</small></div><div><span>{{ trainingBoard.joinLabel }}</span><bdi>{{ g.cost }}</bdi></div><div><span>{{ t.gymXp }}</span><bdi>{{ g.xp }}</bdi></div><div><span>{{ t.energyPer }}</span><bdi>{{ g.energy }}</bdi></div><button onClick=\"{{ g.join }}\" disabled=\"{{ g.disabled }}\" style=\"background:{{ g.btnBg }};color:{{ g.btnFg }}\">{{ g.btn }}</button></div></sc-for></section>\n      </sc-if>\n\n      ",
