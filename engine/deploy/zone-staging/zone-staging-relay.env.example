# PREPARATION ONLY. Render to /etc/zone-staging/relay.env, root:root 0600.
ZONE_ENGINE_RELAY_KEY=REPLACE_RELAY_KEY
ZONE_ENGINE_PUBLIC_HOSTS=REPLACE_ALLOWED_VERCEL_HOST
ZONE_ENGINE_LOCAL_PORT=54301
ZONE_ENGINE_RELAY_PORT=55437
# Key/allowlist must exactly match the FPM pool and isolated Vercel candidate.
# The existing relay CLI binds IPv4 loopback; no public listening override.
