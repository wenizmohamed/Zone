# PREPARATION ONLY. Render to /etc/zone-staging/engine.env, root:root 0600.
# Restore and review this dedicated DB first. Never use PC source DB or another app DB.
ZONE_DATABASE_URL=postgresql://REPLACE_DB_ROLE:REPLACE_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/REPLACE_RESTORED_STAGING_DATABASE?sslmode=require
ZONE_ENGINE_RELAY_KEY=REPLACE_RELAY_KEY
ZONE_ENGINE_PUBLIC_HOSTS=REPLACE_ALLOWED_VERCEL_HOST
# VERCEL=1 and ZONE_PLAYER_SESSIONS=1 are explicitly set in the FPM pool.
# No Redis, direct owner secrets, legacy founder adapter or beta grants here.
