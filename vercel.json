{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": false,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{.tools/**,.vercel/**,node_modules/**,public/**,art/**,assets/**,dist/**,lib/**,docs/**,scripts/**,engine/{bin,tests,var}/**,*.{html,css,js,jpeg,txt,py,ico,svg,md}}"
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index?__zone_path=/api/v1/:path*" },
    { "source": "/engine", "destination": "/api/index?__zone_path=/engine" },
    { "source": "/engine/:path*", "destination": "/api/index?__zone_path=/engine/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(art|assets|dist|lib)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
