# ZONE engine persistence
ZONE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required production owner control-plane secret. Generate privately; never use this placeholder.
ZONE_ADMIN_TOKEN=replace-with-a-long-random-private-owner-secret

# Explicit no-sign-in control-plane access for the owner's testing beta only.
# Leave at 0 for handover; existing owner credentials are retained unchanged.
ZONE_BETA_OWNER_ACCESS=0

# Vercel enables browser player sessions automatically. Enable explicitly for local beta checks.
ZONE_PLAYER_SESSIONS=1

# Optional production adapters
ZONE_REDIS_URL=redis://user:password@host:6379
ZONE_ASSET_STORAGE_URL=s3://bucket/prefix
